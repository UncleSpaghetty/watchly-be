# Copiare in /opt/watchly-be/.env (chmod 600). Non committare valori reali.

WATCHLY_IMAGE_OWNER=owner
WATCHLY_IMAGE_TAG=latest
WATCHLY_API_DOMAIN=api.watchly.example

POSTGRES_DB=watchly
POSTGRES_USER=watchly_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://watchly_app:change-me@postgres:5432/watchly

ENVIRONMENT=production
LOG_LEVEL=INFO

# Origini ammesse (frontend), separate da virgola. Il cookie di sessione richiede HTTPS.
ALLOWED_ORIGINS=https://watchly.example
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30

# Google Identity Services: OAuth Web client ID (non il client secret).
GOOGLE_CLIENT_ID=

# Utente proprietario creato al primo avvio (registrazione pubblica assente).
OWNER_EMAIL=
OWNER_PASSWORD=

# TMDB (token di lettura v4, solo server-side)
TMDB_READ_TOKEN=

# Feed RSS separati da virgola
NEWS_FEED_URLS=

# Web Push (generare con: vapid --gen). Chiave privata solo backend.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@watchly.example

SYNC_INTERVAL_HOURS=12
SYNC_COOLDOWN_SECONDS=300
NEWS_REFRESH_MINUTES=30
WORKER_TICK_SECONDS=30
