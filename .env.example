# Sviluppo locale: copiare in .env. Per produzione usare deploy/env.example.
# SQLite non richiede servizi; per PostgreSQL: docker compose -f deploy/compose.dev.yaml up -d postgres
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://watchly_app:watchly@localhost:5432/watchly

ENVIRONMENT=development
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
OWNER_EMAIL=dev@example.com
OWNER_PASSWORD=dev-password-change-me
