# Sviluppo locale: copiare in .env. Per produzione usare .env.production.example.
# SQLite non richiede servizi; per PostgreSQL: docker compose up -d database
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://watchly_app:watchly@localhost:5432/watchly

ENVIRONMENT=development
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
OWNER_EMAIL=dev@example.com
OWNER_PASSWORD=dev-password-change-me

# OAuth Web client ID condiviso con NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend.
GOOGLE_CLIENT_ID=

# Feed RSS separati da virgola; il worker li aggiorna in background.
NEWS_FEED_URLS=
NEWS_REFRESH_MINUTES=30
